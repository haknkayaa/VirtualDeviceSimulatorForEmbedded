{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vds4e.dev/schemas/server-config.schema.json",
  "title": "VDS4E server configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "server", "data_plane", "observability", "device_models"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_address"],
      "properties": {
        "control_address": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "data_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unix_socket"],
      "properties": {
        "unix_socket": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_level"],
      "properties": {
        "log_level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"]
        }
      }
    },
    "device_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scenarios": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
