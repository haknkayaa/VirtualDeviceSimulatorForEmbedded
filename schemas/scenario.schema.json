{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vds4e.dev/schemas/scenario.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "timeout_ms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "continue_on_failure": { "type": "boolean" },
        "action": {
          "enum": ["reset_device", "send_spi", "advance_time", "enable_fault", "disable_fault", "assert_register", "assert_state", "assert_response", "assert_error", "wait_for_event"]
        },
        "device": { "type": "string", "minLength": 1 },
        "tx": { "type": "string", "pattern": "^([0-9A-Fa-f]{2})(\\s+[0-9A-Fa-f]{2})*$" },
        "save_as": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "fault": { "type": "string", "minLength": 1 },
        "register": { "type": "string", "minLength": 1 },
        "expected": {},
        "source": { "type": "string", "minLength": 1 },
        "expected_code": { "type": "string", "minLength": 1 },
        "event": { "type": "string", "enum": ["device_operation_started", "device_operation_completed", "state_transition", "fault_triggered", "fault_delay_completed"] },
        "timeout_ms": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "reset_device" } } }, "then": { "required": ["device"] } },
        { "if": { "properties": { "action": { "const": "send_spi" } } }, "then": { "required": ["device", "tx", "save_as"] } },
        { "if": { "properties": { "action": { "const": "advance_time" } } }, "then": { "required": ["duration_ms"] } },
        { "if": { "properties": { "action": { "enum": ["enable_fault", "disable_fault"] } } }, "then": { "required": ["fault"] } },
        { "if": { "properties": { "action": { "const": "assert_register" } } }, "then": { "required": ["device", "register", "expected"], "properties": { "expected": { "type": "integer", "minimum": 0 } } } },
        { "if": { "properties": { "action": { "const": "assert_state" } } }, "then": { "required": ["device", "expected"], "properties": { "expected": { "type": "string", "minLength": 1 } } } },
        { "if": { "properties": { "action": { "const": "assert_response" } } }, "then": { "required": ["source", "expected"], "properties": { "expected": { "type": "string", "minLength": 2 } } } },
        { "if": { "properties": { "action": { "const": "assert_error" } } }, "then": { "required": ["source", "expected_code"] } },
        { "if": { "properties": { "action": { "const": "wait_for_event" } } }, "then": { "required": ["event", "timeout_ms"] } }
      ]
    }
  }
}
