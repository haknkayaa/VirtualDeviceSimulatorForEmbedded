{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vds4e.dev/schemas/device-model.schema.json",
  "title": "VDS4E generic device model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bus", "model", "commands"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bus": {
          "enum": ["spi", "i2c", "gpio", "uart"]
        },
        "model": {
          "enum": ["generic-spi-command", "generic-i2c-register", "at24c-eeprom", "generic-gpio-bank", "generic-uart-responder"]
        },
        "spi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "transfer_bits"],
          "properties": {
            "mode": { "type": "integer", "minimum": 0, "maximum": 3 },
            "transfer_bits": { "type": "integer", "minimum": 1, "maximum": 32 },
            "max_frequency_hz": { "type": "integer", "minimum": 1 },
            "supports_dtr": { "type": "boolean" }
          }
        },
        "gpio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lines"],
          "properties": {
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["offset", "name", "direction"],
                "properties": {
                  "offset": { "type": "integer", "minimum": 0, "maximum": 1023 },
                  "name": { "type": "string", "minLength": 1, "maxLength": 31 },
                  "direction": { "enum": ["input", "output"] },
                  "initial_value": { "type": "boolean" },
                  "active_low": { "type": "boolean" },
                  "register": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "i2c": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "register_address_bytes": { "type": "integer", "minimum": 1, "maximum": 4 },
            "auto_increment": { "type": "boolean" },
            "write_cycle_us": { "type": "integer", "minimum": 1 },
            "write_protect": { "type": "boolean" }
          }
        },
        "uart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baud_rate", "responses"],
          "properties": {
            "baud_rate": { "type": "integer", "minimum": 1 },
            "data_bits": { "type": "integer", "minimum": 5, "maximum": 8 },
            "stop_bits": { "type": "integer", "minimum": 1, "maximum": 2 },
            "parity": { "enum": ["none", "even", "odd"] },
            "responses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["request", "response"],
                "properties": {
                  "request": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2048,
                    "items": { "type": "integer", "minimum": 0, "maximum": 255 }
                  },
                  "response": {
                    "type": "array",
                    "maxItems": 2048,
                    "items": { "type": "integer", "minimum": 0, "maximum": 255 }
                  }
                }
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "opcode"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "opcode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "response": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "operation": {
                "type": "string",
                "enum": ["register_read", "register_write", "memory_read", "page_program", "sector_erase", "chip_erase"]
              },
              "address_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "register": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "type": "string",
                "minLength": 1
              },
              "event_delay_us": {
                "type": "integer",
                "minimum": 1
              },
              "timing": {
                "type": "object",
                "additionalProperties": false,
                "required": ["latency_us", "busy_during_operation"],
                "properties": {
                  "latency_us": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "busy_during_operation": {
                    "type": "boolean"
                  }
                }
              },
              "allowed_states": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "wire": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command_width", "address_width", "data_width", "rate"],
                "properties": {
                  "command_width": { "enum": ["single", "dual", "quad"] },
                  "address_width": { "enum": ["single", "dual", "quad"] },
                  "data_width": { "enum": ["single", "dual", "quad"] },
                  "rate": { "enum": ["str", "dtr"] },
                  "dummy_cycles": { "type": "integer", "minimum": 0, "maximum": 65535 }
                }
              },
              "shortcut": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tx", "rx_length"],
                "properties": {
                  "tx": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer", "minimum": 0, "maximum": 255 }
                  },
                  "rx_length": { "type": "integer", "minimum": 0 },
                  "description": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size_bytes", "page_size_bytes", "sector_size_bytes", "erased_value"],
          "properties": {
            "size_bytes": { "type": "integer", "minimum": 1 },
            "page_size_bytes": { "type": "integer", "minimum": 1 },
            "sector_size_bytes": { "type": "integer", "minimum": 1 },
            "erased_value": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "registers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "address", "width_bits", "reset_value", "access"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": "integer",
                "minimum": 0
              },
              "width_bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "reset_value": {
                "type": "integer",
                "minimum": 0
              },
              "access": {
                "type": "string",
                "enum": ["ro", "wo", "rw"]
              },
              "description": {
                "type": "string"
              },
              "bitfields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "lsb", "width", "access"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "lsb": { "type": "integer", "minimum": 0, "maximum": 63 },
                    "width": { "type": "integer", "minimum": 1, "maximum": 64 },
                    "access": { "type": "string", "enum": ["ro", "wo", "rw"] },
                    "description": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "busy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["register_address", "mask"],
          "properties": {
            "register_address": {
              "type": "integer",
              "minimum": 0
            },
            "mask": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "faults": {
          "type": "array",
          "items": { "$ref": "#/$defs/fault" }
        },
        "state_machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_state", "states"],
          "properties": {
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "states": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/state"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "bus": { "const": "spi" } } },
          "then": {
            "properties": {
              "model": { "const": "generic-spi-command" },
              "commands": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "bus": { "const": "i2c" } } },
          "then": {
            "required": ["i2c"],
            "properties": {
              "model": { "enum": ["generic-i2c-register", "at24c-eeprom"] },
              "commands": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "bus": { "const": "gpio" } } },
          "then": {
            "required": ["gpio"],
            "properties": {
              "model": { "const": "generic-gpio-bank" },
              "commands": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "bus": { "const": "uart" } } },
          "then": {
            "required": ["uart"],
            "properties": {
              "model": { "const": "generic-uart-responder" },
              "commands": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "trigger", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "priority": { "type": "integer" },
        "persistent": { "type": "boolean" },
        "target": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "device": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "register": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 }
          }
        },
        "trigger": {
          "oneOf": [
            { "const": "always" },
            { "type": "object", "additionalProperties": false, "required": ["first_n"], "properties": { "first_n": { "type": "integer", "minimum": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["every_nth"], "properties": { "every_nth": { "type": "integer", "minimum": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["operation_count"], "properties": { "operation_count": { "type": "integer", "minimum": 1 } } }
          ]
        },
        "action": { "$ref": "#/$defs/fault_action" }
      }
    },
    "fault_action": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "duration_ms"], "properties": { "type": { "const": "timeout" }, "duration_ms": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "duration_ms"], "properties": { "type": { "const": "delay" }, "duration_ms": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "code", "message"], "properties": { "type": { "const": "return_error" }, "code": { "type": "string", "minLength": 1 }, "message": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "drop" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "xor_mask"], "properties": { "type": { "const": "corrupt_response" }, "xor_mask": { "type": "integer", "minimum": 0, "maximum": 255 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "force_register_value" }, "value": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "stuck_at" }, "value": { "type": "integer", "minimum": 0 }, "mask": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "exit_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "delayed_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delayed_event"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_register"],
      "properties": {
        "set_register": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "mask": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register"],
      "properties": {
        "register": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "equals"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "integer",
              "minimum": 0
            },
            "mask": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "target"],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "$ref": "#/$defs/guard"
        }
      }
    },
    "delayed_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "delay_us"],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "delay_us": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
