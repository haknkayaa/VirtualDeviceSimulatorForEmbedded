{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vds4e.dev/schemas/device-model.schema.json",
  "title": "VDS4E generic device model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "bus", "model", "commands"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bus": {
          "const": "spi"
        },
        "model": {
          "const": "generic-spi-command"
        },
        "spi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "transfer_bits"],
          "properties": {
            "mode": { "const": 0 },
            "transfer_bits": { "const": 8 }
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "opcode"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "opcode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "response": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "operation": {
                "type": "string",
                "enum": ["register_read", "register_write", "memory_read", "page_program", "sector_erase", "chip_erase"]
              },
              "address_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "register": {
                "type": "string",
                "minLength": 1
              },
              "event": {
                "type": "string",
                "minLength": 1
              },
              "event_delay_us": {
                "type": "integer",
                "minimum": 1
              },
              "timing": {
                "type": "object",
                "additionalProperties": false,
                "required": ["latency_us", "busy_during_operation"],
                "properties": {
                  "latency_us": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "busy_during_operation": {
                    "type": "boolean"
                  }
                }
              },
              "allowed_states": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size_bytes", "page_size_bytes", "sector_size_bytes", "erased_value"],
          "properties": {
            "size_bytes": { "type": "integer", "minimum": 1 },
            "page_size_bytes": { "type": "integer", "minimum": 1 },
            "sector_size_bytes": { "type": "integer", "minimum": 1 },
            "erased_value": { "type": "integer", "minimum": 0, "maximum": 255 }
          }
        },
        "registers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "address", "width_bits", "reset_value", "access"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": "integer",
                "minimum": 0
              },
              "width_bits": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "reset_value": {
                "type": "integer",
                "minimum": 0
              },
              "access": {
                "type": "string",
                "enum": ["ro", "wo", "rw"]
              }
            }
          }
        },
        "busy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["register_address", "mask"],
          "properties": {
            "register_address": {
              "type": "integer",
              "minimum": 0
            },
            "mask": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "faults": {
          "type": "array",
          "items": { "$ref": "#/$defs/fault" }
        },
        "state_machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_state", "states"],
          "properties": {
            "initial_state": {
              "type": "string",
              "minLength": 1
            },
            "states": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "$ref": "#/$defs/state"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "trigger", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean" },
        "priority": { "type": "integer" },
        "persistent": { "type": "boolean" },
        "target": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "device": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 },
            "register": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 }
          }
        },
        "trigger": {
          "oneOf": [
            { "const": "always" },
            { "type": "object", "additionalProperties": false, "required": ["first_n"], "properties": { "first_n": { "type": "integer", "minimum": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["every_nth"], "properties": { "every_nth": { "type": "integer", "minimum": 1 } } },
            { "type": "object", "additionalProperties": false, "required": ["operation_count"], "properties": { "operation_count": { "type": "integer", "minimum": 1 } } }
          ]
        },
        "action": { "$ref": "#/$defs/fault_action" }
      }
    },
    "fault_action": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "duration_ms"], "properties": { "type": { "const": "timeout" }, "duration_ms": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "duration_ms"], "properties": { "type": { "const": "delay" }, "duration_ms": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "code", "message"], "properties": { "type": { "const": "return_error" }, "code": { "type": "string", "minLength": 1 }, "message": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "drop" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "xor_mask"], "properties": { "type": { "const": "corrupt_response" }, "xor_mask": { "type": "integer", "minimum": 0, "maximum": 255 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "force_register_value" }, "value": { "type": "integer", "minimum": 0 } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": { "type": { "const": "stuck_at" }, "value": { "type": "integer", "minimum": 0 }, "mask": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "exit_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "delayed_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delayed_event"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_register"],
      "properties": {
        "set_register": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "mask": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register"],
      "properties": {
        "register": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "equals"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "equals": {
              "type": "integer",
              "minimum": 0
            },
            "mask": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "target"],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "$ref": "#/$defs/guard"
        }
      }
    },
    "delayed_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "delay_us"],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "delay_us": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
