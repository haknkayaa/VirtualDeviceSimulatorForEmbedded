	(text "• 3V3_OUT: TPS2553 limited to ~300 mA (88.7k), blocks reverse current from the user device."
		(exclude_from_sim no)
		(at 17.78 40.64 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "4271c43e-a926-55fe-a1f0-a85295d41b70")
	)
	(text "• 5V_OUT: TPS26600 opens above ~6.0 V VBUS (OVP 100k/24.9k), UVLO ~4.4 V, ILIM 0.3 A (39k)."
		(exclude_from_sim no)
		(at 17.78 34.29 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "7d7ca424-14a8-5c91-8162-dba053b0a092")
	)
	(text "• D12/D13 3.6 V zeners keep OVP/UVLO pins below their 5 V abs max at 24 V and during TVS clamping."
		(exclude_from_sim no)
		(at 17.78 36.83 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "9e698bc1-93ac-5515-83f9-96954c769312")
	)
	(text "AUX POWER OUTPUTS (J10 5V_OUT / 3V3_OUT)"
		(exclude_from_sim no)
		(at 17.78 26.67 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "becb5080-f6d9-5b5d-b066-f3e08e9a3e3d")
	)
	(text "• Never tied to VREF or the Raspberry Pi 5 V / 3.3 V pins (no back-powering)."
