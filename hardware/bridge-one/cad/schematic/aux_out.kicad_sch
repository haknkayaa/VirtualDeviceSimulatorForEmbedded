		(at 17.78 43.18 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "d3ec2e4f-7ed7-57a2-a013-a5be953ebb63")
	)
