	(text "• GPIO: per-bit DIR from FPGA (10k pull-down = B->A input default), common OE gated."
		(exclude_from_sim no)
		(at 17.78 45.72 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "20204e0f-03a6-5dd0-8764-5096529b9fb1")
	)
	(text "• I2C: PCA9617A repeaters, port A = target (VTREF_IO 0.8-5.5 V), port B = MCU 3.3 V; equal rails supported."
		(exclude_from_sim no)
		(at 17.78 34.29 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "2075455d-5be5-5649-98b3-12059a0c6329")
	)
	(text "• EN = gated I2Cn_EN_DRV (10k pull-down); no bias path from +3V3 into VTREF. B side has <=0.6 V static offset."
		(exclude_from_sim no)
		(at 17.78 36.83 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "5b7a7661-20a9-5a46-b476-009a04abced5")
	)
	(text "• AVC/AXC: VCCA = +3V3, VCCB = VTREF_IO (1.65-3.6 V); DIR/OE referenced to VCCA; Ioff isolates when unpowered."
		(exclude_from_sim no)
		(at 17.78 31.75 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "79213733-bf0d-5670-96b7-2d1863c4fc6d")
	)
	(text "TARGET LEVEL TRANSLATORS AND I2C REPEATERS"
		(exclude_from_sim no)
		(at 17.78 26.67 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "82957a34-f775-54c2-bb42-1ebeb968971d")
	)
	(text "• UART: bank 1 bridge->target, bank 2 target->bridge, fixed. SPI: U6 target->FPGA, U7 MISO only."
		(exclude_from_sim no)
		(at 17.78 43.18 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "b9118a06-1240-508d-86a8-e0f152e1cfa5")
	)
	(text "• MCU-side I2C pull-ups 4k7 fitted; target-side 4k7 to VTREF_IO DNP (R87-R90): targets usually have their own."
		(exclude_from_sim no)
		(at 17.78 49.53 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "deb17246-b81b-54d1-b57d-0b36e630372f")
	)
	(text "• BENCH: ESP32 open-drain low <= 0.4 V under load (B-side requirement); 1.65 V targets have ~12 mV VIL margin."
		(exclude_from_sim no)
		(at 17.78 40.64 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "e32289d1-0110-54c6-abcb-168ecb38cb11")
	)
