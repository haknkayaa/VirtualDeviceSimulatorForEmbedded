	(text "• VTREF is an input reference only: 470k/470k divider keeps backfeed ~3 uA."
		(exclude_from_sim no)
		(at 17.78 40.64 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "3cfba75c-cd29-51a1-9eb6-3d65491fa605")
	)
	(text "• Global wins: PORT_GATE_N = PORT_OE_N OR VTREF_BAD; every port enable is gated by it in hardware."
		(exclude_from_sim no)
		(at 17.78 31.75 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "457a1a22-5ef4-5f52-bebb-d2c07d5571dc")
	)
	(text "TARGET ISOLATION LOGIC + VTREF SENSE"
		(exclude_from_sim no)
		(at 17.78 26.67 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6931236a-659f-520c-9aa5-6170324d5ff8")
	)
	(text "• Reset default = isolated (pull-ups on *_OE_N / *_OFF, FPGA outputs Hi-Z until configured)."
		(exclude_from_sim no)
		(at 17.78 34.29 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "908b4c63-c3e6-50c9-8abd-8e32b86ea8d7")
	)
	(text "• Ref: research/target-interface-spec.md, research/pinouts-and-gates.md"
		(exclude_from_sim no)
		(at 17.78 49.53 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "97575a77-cb27-530c-8e03-b38039a407e3")
	)
	(text "• OVP: Q1 P-FET passes VTREF only while U24 sees VTREF < 3.81 V (3.0M/750k vs VREF_LOW) and +3V3 is up; else VTREF_IO is cut."
		(exclude_from_sim no)
		(at 17.78 43.18 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "c5f99c80-0e39-5ef1-85a2-35b3eb5710a1")
	)
	(text "• VTREF_BAD when VTREF < ~1.5 V (TLV7011 vs 0.76 V ref, own unfiltered 47k/47k divider: fast); runs from +3V3."
		(exclude_from_sim no)
		(at 17.78 36.83 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "ee2d4567-35fa-5c85-b828-ed0320b9d767")
	)
	(text "• Q2 (60 V) takes the fault voltage instead of the comparator output. Ref: research/vtref-ovp-and-fpga-supervisor.md"
		(exclude_from_sim no)
		(at 17.78 45.72 0)
		(effects
			(font
				(size 1.6 1.6)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "f4495698-4421-5b4e-ac47-11a0d496324b")
	)
